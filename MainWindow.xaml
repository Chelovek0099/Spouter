<Window x:Class="Soundpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundpad"
        mc:Ignorable="d"
        Title="Simple Soundpad"
        Height="600"
        Width="1000"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Стиль для пэдов, чтобы они были одинакового размера -->
        <Style x:Key="PadBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#303030"/>
        </Style>
    </Window.Resources>

    <Grid Background="#1A1A1A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /> <!-- Основная сетка пэдов -->
            <ColumnDefinition Width="280" /> <!-- Боковая панель -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: ПЭДЫ -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Simple Soundpad" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <ComboBox Width="200" HorizontalAlignment="Left" Margin="0,5,0,0"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice}"
                          DisplayMemberPath="Name" />
            </StackPanel>

            <!-- Скролл с пэдами -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Pads}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.Resources>
                        <!-- Шаблон обычного пэда -->
                        <DataTemplate DataType="{x:Type local:PadViewModel}">
                            <Border Style="{StaticResource PadBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0-6">
                                        <Button Content="Set key" Width="60" Height="18" FontSize="9" Click="SetHotkeyButton_Click" />
                                        <TextBlock Text="{Binding Hotkey}" Foreground="#CCCCCC" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="0,8,0,5">
                                        <Button Content="Load" Margin="2" Click="LoadButton_Click" />
                                        <Button Content="Play" Margin="2" Click="PlayButton_Click" />
                                    </UniformGrid>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Margin="0,5"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#888" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>

                    <!-- Добавление кнопки "+" в конец списка через Footer или замену ItemsSource в C# -->
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Кнопка добавить (плавающая или в конце) -->
            <Button Content="+" 
                    Width="40" Height="40" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                    Margin="20" FontSize="24"
                    Click="AddPad_Click"
                    ToolTip="Добавить новый пэд"/>
        </Grid>

        <!-- ПРАВАЯ ЧАСТЬ: ПОИСК ЗВУКОВ -->
        <Border Grid.Column="1" Background="#252525" BorderBrush="#333" BorderThickness="1,0,0,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Поиск -->
                    <RowDefinition Height="*" />    <!-- Список результатов -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Поиск MyInstance" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="SearchBox" 
                             Height="25" 
                             Background="#333" 
                             Foreground="White" 
                             BorderThickness="0" 
                             VerticalContentAlignment="Center"
                             Padding="5,0"/>
                    <Button Content="Найти" Margin="0,5,0,0" Click="Search_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="SearchResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#333" Margin="0,0,0,5" Padding="5" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SoundName}" Foreground="White" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="⬇" Width="25" Click="DownloadSound_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>