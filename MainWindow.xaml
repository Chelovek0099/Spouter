<Window x:Class="Soundpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundpad"
        mc:Ignorable="d"
        Title="Simple Soundpad"
        Height="450"
        Width="800"
        KeyDown="Window_KeyDown">
    <Grid Background="#202020" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                <TextBlock Text="Simple Soundpad"
                           Foreground="White"
                           FontSize="18" />
                <TextBlock Text="Хоткеи по умолчанию: F1–F8, можно переназначить"
                           Foreground="#CCCCCC"
                           FontSize="10" />
                <TextBlock Text="Чтобы вывести в микрофон — выбери виртуальный кабель/микшер как Output, а его уже используй как микрофон в Discord/OBS."
                           Foreground="#888888"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Width="380" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Output:"
                           VerticalAlignment="Center"
                           Foreground="#CCCCCC"
                           Margin="0,0,4,0" />
                <ComboBox Width="260"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice}"
                          DisplayMemberPath="Name" />
            </StackPanel>
        </DockPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Pads}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="2" Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PadViewModel}">
                    <Border Margin="5" Padding="8" CornerRadius="6" Background="#303030">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding HotkeyDisplay, StringFormat=Key: {0}}"
                                           Foreground="#CCCCCC"
                                           FontSize="10"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <Button Content="Set key"
                                        Width="70"
                                        Height="20"
                                        FontSize="10"
                                        Click="OnSetKeyClick" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Load"
                                        Width="60"
                                        Margin="0,0,6,0"
                                        Click="LoadButton_Click" />
                                <Button Content="Play"
                                        Width="60"
                                        Click="PlayButton_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Vol"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,4,0" />
                                <Slider Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120" />
                            </StackPanel>

                            <TextBlock Text="{Binding FilePath}"
                                       Foreground="#AAAAAA"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
